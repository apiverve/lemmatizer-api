{
    "name": "apiverve/lemmatizer",
    "description": "Text Lemmatizer reduces inflected words in submitted text down to their dictionary base forms. It confirms when valid lemmas exist, while paid plans return full word-by-word mappings.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "lemmatizer",
        "text lemmatizer api",
        "lemmatize text",
        "word lemmatization",
        "find lemma of word",
        "convert words to root form"
    ],
    "homepage": "https://apiverve.com/marketplace/lemmatizer?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/lemmatizer",
        "source": "https://github.com/apiverve/lemmatizer-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Lemmatizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Lemmatizer\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
